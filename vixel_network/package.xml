<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vixel_network</name>
  <version>0.2.0</version>
  <description>Allowlist-only NetworkManager setup for Vixel sensor links.</description>
  <maintainer email="sn3rt@users.noreply.github.com">sn3rt</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/sn3rt/vixel</url>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ethtool</exec_depend>
  <exec_depend>network-manager</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
