# Project-local environment for direnv.
# Put machine-specific overrides in .env; that file is intentionally not tracked.
dotenv_if_exists .env

export VIXEL_ROOT="$PWD"
export VIXEL_ROS_DISTRO="${VIXEL_ROS_DISTRO:-lyrical}"

# The standard local installer location is detected; .env can override it.
arena_candidate="$VIXEL_ROOT/../ArenaSDK_Linux_x64"
if [[ -z "${ARENA_SDK_ROOT:-}" && -d "$arena_candidate/include/Arena" ]]; then
  export ARENA_SDK_ROOT="$arena_candidate"
fi
unset arena_candidate

ros_setup="/opt/ros/${VIXEL_ROS_DISTRO}/setup.bash"
if [[ ! -r "$ros_setup" ]]; then
  echo "vixel: ROS 2 '$VIXEL_ROS_DISTRO' not found at $ros_setup" >&2
  return 1
fi

source "$ros_setup"

# Pick up this package's overlay after the first successful colcon build.
if [[ -r "$VIXEL_ROOT/install/vixel/share/vixel/local_setup.bash" ]]; then
  source "$VIXEL_ROOT/install/local_setup.bash"
  PATH_add "$VIXEL_ROOT/install/vixel_manager/lib/vixel_manager"
  PATH_add "$VIXEL_ROOT/install/vixel_network/lib/vixel_network"
fi

watch_file vixel_bringup/package.xml vixel_interfaces/package.xml
watch_file vixel_lucid/package.xml vixel_manager/package.xml
watch_file vixel_genicam/package.xml vixel_aravis_vendor/package.xml
watch_file vixel_network/package.xml vixel_web/package.xml
watch_file .env
