# Copy to .env for machine-specific overrides. The default is ROS 2 Lyrical.
# VIXEL_ROS_DISTRO=lyrical

# Uncomment when Arena SDK is not discoverable through its installer metadata.
# ARENA_SDK_ROOT=/home/your-user/ArenaSDK_Linux_x64

# Add future deployment-specific values here. Runtime configuration is passed
# with the machine_file/inventory_file ROS launch arguments.
